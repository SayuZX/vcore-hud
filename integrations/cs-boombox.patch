@@ -1128,3 +1128,67 @@
     
     return queue[uniqueId]
 end)
+
+local vcoreBridgeOwners = {}
+local function vcoreFinite(value)
+    return type(value) == 'number' and value == value and math.abs(value) ~= math.huge
+end
+local function vcoreOwned(uniqueId)
+    local caller = GetInvokingResource()
+    return caller == (config.vcoreOwner or 'vcore-hud') and vcoreBridgeOwners[uniqueId] == caller and data[uniqueId]
+end
+
+exports('VcoreEnsurePlayer', function(uniqueId, model)
+    local caller = GetInvokingResource()
+    if caller ~= (config.vcoreOwner or 'vcore-hud') or type(uniqueId) ~= 'string' or #uniqueId > 32 or not uniqueId:match('^%d+$')
+        or type(model) ~= 'string' or type(config.models[model]) ~= 'table' or not config.models[model].enabled then return false end
+    if vcoreBridgeOwners[uniqueId] and vcoreBridgeOwners[uniqueId] ~= caller then return false end
+    vcoreBridgeOwners[uniqueId] = caller
+    if not data[uniqueId] then
+        data[uniqueId] = {
+            media = { playing = false, stopped = true, time = 0, volume = 0, loop = false },
+            syncedPlayers = 0,
+            config = config.models[model]
+        }
+    end
+    queue[uniqueId] = queue[uniqueId] or {}
+    return true
+end)
+
+exports('VcoreSetVolume', function(uniqueId, volume)
+    local player = vcoreOwned(uniqueId)
+    if not player or not vcoreFinite(volume) then return false end
+    local maximum = tonumber(player.config.maxVolumePercent) or 100
+    player.media.volume = math.max(0, math.min(1, maximum / 100, volume))
+    SyncData(uniqueId)
+    return player.media.volume
+end)
+
+exports('VcoreSeek', function(uniqueId, time)
+    local player = vcoreOwned(uniqueId)
+    if not player or not player.media.url or not vcoreFinite(time) or time < 0 or time > 21600 then return false end
+    if vcoreFinite(player.media.duration) and player.media.duration > 0 then time = math.min(time, math.max(0, player.media.duration - 0.5)) end
+    player.media.time = time
+    SyncData(uniqueId, nil, { media = { seek = true } })
+    return time
+end)
+
+exports('VcoreDestroyPlayer', function(uniqueId)
+    local player = vcoreOwned(uniqueId)
+    if not player then return false end
+    player.media.playing = false
+    player.media.stopped = true
+    player.media.time = 0
+    queue[uniqueId] = {}
+    syncableObjects[uniqueId] = nil
+    SyncQueue(uniqueId)
+    SyncData(uniqueId, nil, { force = true })
+    for playerId, identifiers in pairs(players) do
+        for index = #identifiers, 1, -1 do
+            if identifiers[index] == uniqueId then table.remove(identifiers, index) end
+        end
+        if controllers[playerId] == uniqueId then controllers[playerId] = nil end
+    end
+    data[uniqueId], queue[uniqueId], vcoreBridgeOwners[uniqueId] = nil, nil, nil
+    return true
+end)
